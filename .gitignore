# 🌍 Bastien-Antigravity Global GitIgnore Template
# Purpose: Unified noise-reduction across the fleet.

# --- System Files ---
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini

# --- IDEs & Editors ---
.vscode/
!.vscode/settings.json
!.vscode/launch.json
!.vscode/tasks.json
!.vscode/extensions.json
.idea/
*.swp
*.swo
*~
.fleet/
.helix/

# --- Build & Dependency Artifacts ---
# Rust
target/
Cargo.lock

# Go
vendor/
go.work
go.work.sum
__debug_bin
*.test

# Python
__pycache__/
*.py[cod]
*$py.class
.env
.venv
env/
venv/
build/
dist/
*.egg-info/

# C++ & Polyglot Shared Libraries
build/
bin/
obj/
*.o
*.a
*.so
*.so.*
*.dylib
*.dylib.*
*.dll
*.out
distconf/libdistconf/*.dylib
distconf/libdistconf/*.so
distconf/python/distconf/*.dylib
distconf/python/distconf/*.so

# Auto-generated Test YAMLs (exclude canonical standalone.yaml symlinks)
distconf/rust/*.yaml
!distconf/rust/standalone.yaml
distconf/python/*.yaml
!distconf/python/standalone.yaml
src/cgo_bridge/*.yaml

# --- Secrets & Config ---
.env*
!.env.example
*.pem
*.key
*.cert
secrets.yaml

# --- Project Specific Noise ---
zzz_memo
*.bak
*.tmp
temp/

# Chroma DB
.chroma_db*

# --- Standard Ecosystem Protections ---
*.log
*.pyc
.venv/
.pytest_cache/
.coverage
htmlcov/
